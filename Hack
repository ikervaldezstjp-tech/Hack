public class SettingsActivity extends AppCompatActivity {

    private Prefs p;

    @Override
    protected void onCreate(Bundle b) {
        super.onCreate(b);
        setContentView(R.layout.activity_settings);
        p = Prefs.get(this);

        bindSeek(R.id.skFov, R.id.tvFov, 80, 500, p.fov(), new OnInt() {
            @Override
            public void on(int v) {
                p.setFov(v);
                apply();
            }
        });
        bindSeek(R.id.skDelay, R.id.tvDelay, 0, 300, p.delay(), new OnInt() {
            @Override
            public void on(int v) {
                p.setDelay(v);
            }
        });
        bindSeek(R.id.skJitter, R.id.tvJitter, 0, 6, p.jitter(), new OnInt() {
            @Override
            public void on(int v) {
                p.setJitter(v);
            }
        });
        bindSeek(R.id.skThr, R.id.tvThr, 15, 90, Math.round(p.threshold() * 100f), new OnInt() {
            @Override
            public void on(int v) {
                p.setThreshold(v / 100f);
            }
        });
        bindSeek(R.id.skSmooth, R.id.tvSmooth, 20, 400, Math.round(p.msPerPx() * 100f), new OnInt() {
            @Override
            public void on(int v) {
                p.setMsPerPx(v / 100f);
            }
        });

        SeekBar pt = findViewById(R.id.skPoint);
        pt.setMax(2);
        pt.setProgress(p.point());
        pt.setOnSeekBarChangeListener(new Simple() {
            @Override
            public void onProgressChanged(SeekBar s, int v, boolean u) {
                p.setPoint(v);
                ((TextView) findViewById(R.id.tvPoint)).setText(labelPoint(v));
            }
        });
        ((TextView) findViewById(R.id.tvPoint)).setText(labelPoint(p.point()));

        CheckBox always = findViewById(R.id.cbAlways);
        always.setChecked(p.mode() == Prefs.MODE_ALWAYS);
        always.setOnCheckedChangeListener(new CompoundButton.OnCheckedChangeListener() {
            @Override
            public void onCheckedChanged(CompoundButton v, boolean c) {
                p.setMode(c ? Prefs.MODE_ALWAYS : Prefs.MODE_HOLD);
            }
        });

        CheckBox hud = findViewById(R.id.cbHud);
        hud.setChecked(p.excludeHud());
        hud.setOnCheckedChangeListener(new CompoundButton.OnCheckedChangeListener() {
            @Override
            public void onCheckedChanged(CompoundButton v, boolean c) {
                p.setExcludeHud(c);
            }
        });

        CheckBox shz = findViewById(R.id.cbShizuku);
        shz.setChecked(!p.preferA11y());
        shz.setOnCheckedChangeListener(new CompoundButton.OnCheckedChangeListener() {
            @Override
            public void onCheckedChanged(CompoundButton v, boolean c) {
                p.setPreferA11y(!c);
            }
        });

        findViewById(R.id.btnAnchor).setOnClickListener(new android.view.View.OnClickListener() {
            @Override
            public void onClick(android.view.View v) {
                AimService s = AimService.get();
                if (s != null) s.setAnchorEdit(true);
                finish();
            }
        });
    }

    private void apply() {
        AimService s = AimService.get();
        if (s != null) s.refreshSettings();
    }

    private String labelPoint(int v) {
        if (v == Prefs.POINT_HEAD) return "cabeza";
        if (v == Prefs.POINT_CHEST) return "pecho";
        return "cuello";
    }

    private interface OnInt {
        void on(int v);
    }

    private abstract class Simple implements SeekBar.OnSeekBarChangeListener {
        @Override
        public void onStartTrackingTouch(SeekBar s) { }

        @Override
        public void onStopTrackingTouch(SeekBar s) { }
    }

    private void bindSeek(int sk, final int tv, final int min, final int max, int value, final OnInt cb) {
        SeekBar s = findViewById(sk);
        final TextView t = findViewById(tv);
        s.setMax(max - min);
        s.setProgress(value - min);
        t.setText(String.valueOf(value));
        s.setOnSeekBarChangeListener(new Simple() {
            @Override
            public void onProgressChanged(SeekBar sb, int v, boolean u) {
                int real = v + min;
                t.setText(String.valueOf(real));
                cb.on(real);
            }
        });
    }
