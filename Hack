import android.graphics.Canvas;
import android.graphics.Color;
import android.graphics.Paint;
import android.os.Bundle;
import android.os.SystemClock;
import android.view.MotionEvent;
import android.view.View;
import android.widget.SeekBar;
import android.widget.TextView;

import androidx.appcompat.app.AppCompatActivity;

import com.ovltools.core.data.Prefs;

public class CalibrationActivity extends AppCompatActivity {

    private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
    private float markerX = 60f;
    private float startX = 60f;
    private long startTs;
    private float bestMsPerPx;
    private View canvasView;
    private Prefs prefs;

    @Override
    protected void onCreate(Bundle b) {
        super.onCreate(b);
        setContentView(R.layout.activity_calibration);
        prefs = Prefs.get(this);

        canvasView = new View(this) {
            @Override
            protected void onDraw(Canvas c) {
                paint.setStyle(Paint.Style.STROKE);
                paint.setStrokeWidth(2f);
                paint.setColor(0x66FFFFFF);
                c.drawLine(60, getHeight() * 0.5f, getWidth() - 60, getHeight() * 0.5f, paint);
                paint.setColor(0xFFFFC400);
                paint.setStrokeWidth(4f);
                c.drawCircle(markerX, getHeight() * 0.5f, 26f, paint);
            }
        };
        ((android.widget.FrameLayout) findViewById(R.id.ruler)).addView(canvasView,
                new android.widget.FrameLayout.LayoutParams(-1, -1));

        canvasView.setOnTouchListener(new View.OnTouchListener() {
            @Override
            public boolean onTouch(View v, MotionEvent e) {
                float y = canvasView.getHeight() * 0.5f;
                if (e.getY() < y - 120 || e.getY() > y + 120) return false;
                if (e.getActionMasked() == MotionEvent.ACTION_DOWN) {
                    startX = markerX;
                    startTs = SystemClock.uptimeMillis();
                } else if (e.getActionMasked() == MotionEvent.ACTION_MOVE) {
                    markerX = Math.max(60f, Math.min(canvasView.getWidth() - 60f, e.getX()));
                } else if (e.getActionMasked() == MotionEvent.ACTION_UP) {
                    long dur = SystemClock.uptimeMillis() - startTs;
                    float dist = Math.abs(markerX - startX);
                    if (dist > 80 && dur > 80) {
                        bestMsPerPx = dur / dist;
                        ((TextView) findViewById(R.id.tvResult)).setText(
                                String.format(java.util.Locale.US, "%.2f ms/px medidos", bestMsPerPx));
                    }
                    markerX = 60f;
                }
                canvasView.invalidate();
                return true;
            }
        });

        SeekBar gain = findViewById(R.id.skGain);
        gain.setMax(100);
        gain.setProgress(50);
        gain.setOnSeekBarChangeListener(new SeekBar.OnSeekBarChangeListener() {
            @Override
            public void onProgressChanged(SeekBar s, int v, boolean u) {
                ((TextView) findViewById(R.id.tvGain)).setText(String.format(java.util.Locale.US, "x%.2f", 0.5f + v / 100f));
            }

            @Override
            public void onStartTrackingTouch(SeekBar s) { }

            @Override
            public void onStopTrackingTouch(SeekBar s) { }
        });

        findViewById(R.id.btnApply).setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                float base = bestMsPerPx > 0 ? bestMsPerPx : prefs.msPerPx();
                SeekBar g = findViewById(R.id.skGain);
                float gain = 0.5f + g.getProgress() / 100f;
                prefs.setMsPerPx(Math.max(0.05f, base * gain));
                ((TextView) findViewById(R.id.tvResult)).setText(
                        String.format(java.util.Locale.US, "aplicado: %.2f ms/px", prefs.msPerPx()));
            }
        });
    }
