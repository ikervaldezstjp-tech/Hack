import android.content.Intent;
import android.net.Uri;
import android.os.Bundle;
import android.provider.Settings;
import android.view.View;
import android.widget.Button;
import android.widget.TextView;

import androidx.appcompat.app.AppCompatActivity;

import com.ovltools.core.data.Prefs;
import com.ovltools.core.svc.AimAccessibilityService;

public class OnboardingActivity extends AppCompatActivity {

    private int step;
    private TextView title, desc, state;
    private Button action, next;

    @Override
    protected void onCreate(Bundle b) {
        super.onCreate(b);
        setContentView(R.layout.activity_onboarding);
        title = findViewById(R.id.obTitle);
        desc = findViewById(R.id.obDesc);
        state = findViewById(R.id.obState);
        action = findViewById(R.id.obAction);
        next = findViewById(R.id.obNext);

        action.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                if (step == 0) {
                    startActivity(new Intent(Settings.ACTION_MANAGE_OVERLAY_PERMISSION,
                            Uri.parse("package:" + getPackageName())));
                } else if (step == 1) {
                    startActivity(new Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS));
                } else {
                    finish();
                    startActivity(new Intent(OnboardingActivity.this, MainActivity.class));
                }
            }
        });

        next.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                if (step < 2) {
                    step++;
                    render();
                } else {
                    Prefs.get(OnboardingActivity.this).setOnboarded(true);
                    finish();
                }
            }
        });
        render();
    }

    private void render() {
        if (step == 0) {
            title.setText("1/3 · Superponer");
            desc.setText("Dibuja la mira encima del juego.");
            action.setText("Abrir ajuste");
        } else if (step == 1) {
            title.setText("2/3 · Accesibilidad");
            desc.setText("Mueve la mira con gestos.");
            action.setText("Abrir ajuste");
        } else {
            title.setText("3/3 · Captura");
            desc.setText("Se pide al pulsar Iniciar, una vez.");
            action.setText("Entendido");
        }
    }

    @Override
    protected void onResume() {
        super.onResume();
        if (step == 0) {
            state.setText(Settings.canDrawOverlays(this) ? "concedido" : "pendiente");
        } else if (step == 1) {
            state.setText(AimAccessibilityService.isConnected() ? "concedido" : "pendiente");
        } else {
            state.setText("se pedirá al iniciar");
        }
    }
