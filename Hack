import java.util.List;

public class TargetTracker {

    private static final long HOLD_MS = 400L;
    private Detection last;
    private long lastTs;

    public void reset() {
        last = null;
        lastTs = 0;
    }

    public Detection pick(List<Detection> dets, int capW, int capH, long now) {
        if (dets == null || dets.isEmpty()) {
            if (last != null && now - lastTs > HOLD_MS) reset();
            if (last != null) last.persistence = Math.max(0f, 1f - (now - lastTs) / (float) HOLD_MS);
            return last;
        }
        Detection best = null;
        if (last != null && now - lastTs <= HOLD_MS) {
            float maxDist = capW * 0.25f;
            float bestScore = -1f;
            for (Detection d : dets) {
                float dx = d.cx() - last.cx();
                float dy = d.cy() - last.cy();
                float dist = (float) Math.sqrt(dx * dx + dy * dy);
                if (dist > maxDist) continue;
                float s = d.score - dist / maxDist * 0.35f;
                if (s > bestScore) {
                    bestScore = s;
                    best = d;
                }
            }
        }
        if (best == null) {
            float bestScore = -1f;
            for (Detection d : dets) {
                if (d.score > bestScore) {
                    bestScore = d.score;
                    best = d;
                }
            }
        }
        if (best != null) {
            best.persistence = 1f;
            last = best;
            lastTs = now;
        }
        return best;
    }
