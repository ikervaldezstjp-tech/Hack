public class OverlayManager {

    private final Context ctx;
    private final WindowManager wm;

    private CanvasOverlay canvas;
    private BubbleOverlay bubble;
    private AnchorOverlay anchor;

    private WindowManager.LayoutParams canvasLp;
    private WindowManager.LayoutParams bubbleLp;
    private WindowManager.LayoutParams anchorLp;

    public OverlayManager(Context c) {
        ctx = c.getApplicationContext();
        wm = (WindowManager) ctx.getSystemService(Context.WINDOW_SERVICE);
    }

    private int type() {
        return Build.VERSION.SDK_INT >= 26
                ? WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY
                : WindowManager.LayoutParams.TYPE_PHONE;
    }

    public void showCanvas() {
        if (canvas != null) return;
        canvas = new CanvasOverlay(ctx);
        canvasLp = new WindowManager.LayoutParams(
                WindowManager.LayoutParams.MATCH_PARENT,
                WindowManager.LayoutParams.MATCH_PARENT,
                type(),
                WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
                        | WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE
                        | WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS
                        | WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,
                PixelFormat.TRANSLUCENT);
        canvasLp.gravity = Gravity.TOP | Gravity.START;
        wm.addView(canvas, canvasLp);
    }

    public void showBubble(int x, int y) {
        if (bubble != null) return;
        bubble = new BubbleOverlay(ctx);
        bubbleLp = new WindowManager.LayoutParams(
                WindowManager.LayoutParams.WRAP_CONTENT,
                WindowManager.LayoutParams.WRAP_CONTENT,
                type(),
                WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE,
                PixelFormat.TRANSLUCENT);
        bubbleLp.gravity = Gravity.TOP | Gravity.START;
        bubbleLp.x = x;
        bubbleLp.y = y;
        wm.addView(bubble, bubbleLp);
    }

    public void moveBubble(float dx, float dy) {
        if (bubble == null) return;
        bubbleLp.x += (int) dx;
        bubbleLp.y += (int) dy;
        wm.updateViewLayout(bubble, bubbleLp);
    }

    public void showAnchor(float x, float y) {
        if (anchor != null) {
            moveAnchorTo(x, y);
            return;
        }
        anchor = new AnchorOverlay(ctx);
        anchorLp = new WindowManager.LayoutParams(
                96, 96, type(),
                WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE,
                PixelFormat.TRANSLUCENT);
        anchorLp.gravity = Gravity.TOP | Gravity.START;
        anchorLp.x = (int) x - 48;
        anchorLp.y = (int) y - 48;
        wm.addView(anchor, anchorLp);
    }

    public void moveAnchor(float dx, float dy) {
        if (anchor == null) return;
        anchorLp.x += (int) dx;
        anchorLp.y += (int) dy;
        wm.updateViewLayout(anchor, anchorLp);
        if (canvas != null) canvas.setAnchor(anchorLp.x + 48, anchorLp.y + 48);
    }

    public void moveAnchorTo(float x, float y) {
        if (anchor == null) return;
        anchorLp.x = (int) x - 48;
        anchorLp.y = (int) y - 48;
        wm.updateViewLayout(anchor, anchorLp);
        if (canvas != null) canvas.setAnchor(x, y);
    }

    public void hideAnchor() {
        if (anchor == null) return;
        try {
            wm.removeView(anchor);
        } catch (Throwable ignored) { }
        anchor = null;
    }

    public float anchorX() {
        return anchor != null ? anchorLp.x + 48 : -1;
    }

    public float anchorY() {
        return anchor != null ? anchorLp.y + 48 : -1;
    }

    public void setAnchor(float x, float y) {
        if (canvas != null) canvas.setAnchor(x, y);
    }

    public void setFov(int r) {
        if (canvas != null) canvas.setFov(r);
    }

    public void setAnchorVisible(boolean v) {
        if (canvas != null) canvas.setAnchorVisible(v);
    }

    public void render(List<Detection> dets, float scale) {
        if (canvas != null) canvas.setDetections(dets, scale);
    }

    public BubbleOverlay bubble() {
        return bubble;
    }

    public void destroy() {
        hideAnchor();
        if (bubble != null) {
            try {
                wm.removeView(bubble);
            } catch (Throwable ignored) { }
            bubble = null;
        }
        if (canvas != null) {
            try {
                wm.removeView(canvas);
            } catch (Throwable ignored) { }
            canvas = null;
        }
    }
