import android.content.Context;
import android.graphics.Bitmap;
import android.graphics.Matrix;
import android.graphics.PixelFormat;
import android.hardware.display.DisplayManager;
import android.hardware.display.VirtualDisplay;
import android.media.Image;
import android.media.ImageReader;
import android.media.projection.MediaProjection;
import android.os.Build;
import android.os.Handler;
import android.os.HandlerThread;
import android.util.DisplayMetrics;
import android.util.Log;
import android.view.Display;
import android.view.WindowManager;

import java.nio.ByteBuffer;

public class ScreenCapture {

    private static final String TAG = "ScreenCapture";
    public static final int MAX_SIDE = 640;

    public interface Listener {
        void onFrame(FrameData f);
        void onError(Throwable t);
    }

    private final Context ctx;
    private Listener listener;
    private HandlerThread thread;
    private Handler handler;
    private MediaProjection projection;
    private VirtualDisplay display;
    private ImageReader reader;
    private int capW, capH, screenW, screenH, density;
    private volatile boolean running;
    private final MediaProjection.Callback cb = new MediaProjection.Callback() {
        @Override
        public void onStop() {
            running = false;
        }
    };

    public ScreenCapture(Context c) {
        this.ctx = c.getApplicationContext();
    }

    public void start(MediaProjection mp, Listener l) {
        this.listener = l;
        this.projection = mp;
        thread = new HandlerThread("cap");
        thread.start();
        handler = new Handler(thread.getLooper());
        projection.registerCallback(cb, handler);
        running = true;
        handler.post(new Runnable() {
            @Override
            public void run() {
                create();
            }
        });
    }

    @SuppressWarnings("deprecation")
    private void create() {
        try {
            WindowManager wm = (WindowManager) ctx.getSystemService(Context.WINDOW_SERVICE);
            Display d = wm.getDefaultDisplay();
            DisplayMetrics dm = new DisplayMetrics();
            d.getRealMetrics(dm);
            screenW = dm.widthPixels;
            screenH = dm.heightPixels;
            density = dm.densityDpi;

            int maxSide = Math.max(screenW, screenH);
            float k = maxSide > MAX_SIDE ? MAX_SIDE / (float) maxSide : 1f;
            capW = Math.max(2, Math.round(screenW * k));
            capH = Math.max(2, Math.round(screenH * k));

            reader = ImageReader.newInstance(capW, capH, PixelFormat.RGBA_8888, 3);
            reader.setOnImageAvailableListener(new ImageReader.OnImageAvailableListener() {
                @Override
                public void onImageAvailable(ImageReader r) {
                    onImage(r);
                }
            }, handler);

            display = projection.createVirtualDisplay("ovl", capW, capH, density,
                    DisplayManager.VIRTUAL_DISPLAY_FLAG_AUTO_MIRROR, reader.getSurface(), null, handler);
        } catch (Throwable t) {
            Log.e(TAG, "create fallo", t);
            if (listener != null) listener.onError(t);
        }
    }

    private void onImage(ImageReader r) {
        if (!running) return;
        Image img = null;
        try {
            img = r.acquireLatestImage();
            if (img == null) return;
            Image.Plane plane = img.getPlanes()[0];
            ByteBuffer buf = plane.getBuffer();
            int w = img.getWidth();
            int h = img.getHeight();
            int rowStride = plane.getRowStride();
            int pixelStride = plane.getPixelStride();
            int rowBytes = w * pixelStride;

            Bitmap bmp = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888);
            if (rowStride == rowBytes) {
                bmp.copyPixelsFromBuffer(buf);
            } else {
                byte[] row = new byte[rowBytes];
                byte[] all = new byte[rowBytes * h];
                for (int y = 0; y < h; y++) {
                    buf.position(y * rowStride);
                    buf.get(row, 0, rowBytes);
                    System.arraycopy(row, 0, all, y * rowBytes, rowBytes);
                }
                bmp.copyPixelsFromBuffer(ByteBuffer.wrap(all));
            }

            int rot = 0;
            WindowManager wm = (WindowManager) ctx.getSystemService(Context.WINDOW_SERVICE);
            if (wm != null && wm.getDefaultDisplay() != null) {
                rot = wm.getDefaultDisplay().getRotation();
            }
            int deg = rot * 90;
            if (deg != 0) {
                Matrix m = new Matrix();
                m.postRotate(deg);
                Bitmap rb = Bitmap.createBitmap(bmp, 0, 0, bmp.getWidth(), bmp.getHeight(), m, true);
                if (rb != bmp) bmp.recycle();
                bmp = rb;
            }

            FrameData f = new FrameData(bmp, deg, screenW, screenH, System.currentTimeMillis());
            if (listener != null) listener.onFrame(f);
        } catch (Throwable t) {
            if (listener != null) listener.onError(t);
        } finally {
            if (img != null) {
                try { img.close(); } catch (Throwable ignored) { }
            }
        }
    }

    public void stop() {
        running = false;
        try {
            if (display != null) display.release();
        } catch (Throwable ignored) { }
        display = null;
        try {
            if (reader != null) {
                reader.setOnImageAvailableListener(null, null);
                reader.close();
            }
        } catch (Throwable ignored) { }
        reader = null;
        try {
            if (projection != null) {
                projection.unregisterCallback(cb);
                projection.stop();
            }
        } catch (Throwable ignored) { }
        projection = null;
        if (thread != null) {
            thread.quitSafely();
            thread = null;
        }
        handler = null;
    }

    public int capW() { return capW; }
    public int capH() { return capH; }
    public boolean running() { return running; }
