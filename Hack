import android.accessibilityservice.AccessibilityService;
import android.accessibilityservice.GestureDescription;
import android.graphics.Path;
import android.os.Handler;

import com.ovltools.core.geom.Coords;

public class AccessibilityInjector extends Injector {

    private final AccessibilityService svc;
    private GestureDescription.StrokeDescription current;
    private float curX, curY;
    private int screenW = 1080, screenH = 1920;
    private float pxPerMs = 1.1f;

    public AccessibilityInjector(AccessibilityService s, Handler h) {
        super(h);
        this.svc = s;
    }

    public void setScreen(int w, int h) {
        screenW = w;
        screenH = h;
    }

    public void setPxPerMs(float v) {
        pxPerMs = v <= 0.05f ? 0.05f : v;
    }

    public void setStart(float x, float y) {
        curX = x;
        curY = y;
    }

    @Override
    protected void startStroke(float dx, float dy) {
        current = null;
        emit(dx, dy, false);
    }

    @Override
    protected void continueStroke(float dx, float dy) {
        emit(dx, dy, true);
    }

    private void emit(float dx, float dy, boolean cont) {
        try {
            float ex = Coords.clamp(curX + dx, 0, screenW - 1);
            float ey = Coords.clamp(curY + dy, 0, screenH - 1);
            float dist = (float) Math.sqrt(dx * dx + dy * dy);
            int dur = (int) Coords.clamp(dist / pxPerMs, 40, 220);

            Path p = new Path();
            p.moveTo(curX, curY);
            p.lineTo(ex, ey);

            GestureDescription.StrokeDescription sd;
            if (cont && current != null) {
                sd = current.continueStroke(p, 0, dur, true);
            } else {
                sd = new GestureDescription.StrokeDescription(p, 0, dur, true);
            }
            current = sd;
            curX = ex;
            curY = ey;

            GestureDescription gd = new GestureDescription.Builder().addStroke(sd).build();
            boolean ok = svc.dispatchGesture(gd, new AccessibilityService.GestureResultCallback() {
                @Override
                public void onCompleted(GestureDescription g, boolean more) {
                    completed();
                }

                @Override
                public void onCancelled(GestureDescription g) {
                    completed();
                }
            }, handler);
            if (!ok) completed();
        } catch (Throwable t) {
            completed();
        }
    }
