public class AimService extends Service implements ScreenCapture.Listener {

    private static final String TAG = "AimService";
    private static final String CH = "ovl";
    private static final int NID = 41;

    public static AimService I;

    private final Handler main = new Handler(Looper.getMainLooper());
    private final ExecutorService worker = Executors.newSingleThreadExecutor();
    private final AtomicBoolean busy = new AtomicBoolean(false);
    private final Random rnd = new Random();

    private Prefs prefs;
    private ScreenCapture capture;
    private Detector detector;
    private OverlayManager overlays;
    private TargetTracker tracker;
    private AccessibilityInjector a11y;
    private ShizukuInjector shizuku;
    private Thermal thermal;

    private volatile boolean aiming;
    private volatile boolean alwaysOn;
    private volatile int targetFps = 12;
    private volatile boolean throttled;
    private long lastInferTs;
    private long frameCount;
    private long inferCount;
    private long lastFrameTs;
    private long lastInferMs;
    private float inferMsAvg;
    private float fpsAvg;
    private String modelState = "iniciando";
    private float s = 1f;
    private int screenW, screenH;
    private float anchorX, anchorY;
    private boolean anchorEdit;
    private float[][] hudRects;
    private volatile boolean running;

    private final Runnable aimRunner = new Runnable() {
        @Override
        public void run() {
            if (pendingDx != 0f || pendingDy != 0f) {
                route(pendingDx, pendingDy);
                pendingDx = 0f;
                pendingDy = 0f;
            }
        }
    };
    private float pendingDx, pendingDy;

    public static AimService get() {
        return I;
    }

    @Override
    public void onCreate() {
        super.onCreate();
        I = this;
        prefs = Prefs.get(this);
        overlays = new OverlayManager(this);
        tracker = new TargetTracker();
        a11y = new AccessibilityInjector(AimAccessibilityService.get(), main);
        shizuku = new ShizukuInjector(main);
        shizuku.init();
        detector = new Detector();
        main.post(new Runnable() {
            @Override
            public void run() {
                boolean ok = detector.load(AimService.this);
                modelState = ok ? ("ok/" + detector.backend()) : detector.error();
            }
        });
        thermal = new Thermal();
        thermal.start(this, new Thermal.Listener() {
            @Override
            public void onLevel(int status) {
                throttled = status >= 2;
                targetFps = throttled ? 9 : prefs.fps();
            }
        });
        targetFps = prefs.fps();
        createChannel();
    }

    @Override
    public int onStartCommand(Intent intent, int flags, int startId) {
        if (intent == null) {
            stopSelf();
            return START_NOT_STICKY;
        }
        int code = intent.getIntExtra("code", Activity.RESULT_CANCELED);
        Intent data = null;
        if (Build.VERSION.SDK_INT >= 33) {
            data = intent.getParcelableExtra("data", Intent.class);
        } else {
            data = intent.getParcelableExtra("data");
        }
        if (code != Activity.RESULT_OK || data == null) {
            startForegroundCompat();
            stopSelf();
            return START_NOT_STICKY;
        }
        startForegroundCompat();
        setProjection(code, data);
        return START_STICKY;
    }

    public void setProjection(int code, Intent data) {
        MediaProjectionManager mpm = (MediaProjectionManager) getSystemService(Context.MEDIA_PROJECTION_SERVICE);
        if (mpm == null) return;
        MediaProjection mp = mpm.getMediaProjection(code, data);
        if (mp == null) return;

        WindowManager wm = (WindowManager) getSystemService(Context.WINDOW_SERVICE);
        Point p = new Point();
        if (wm != null) {
            if (Build.VERSION.SDK_INT >= 30) {
                android.graphics.Rect b = wm.getCurrentWindowMetrics().getBounds();
                p.set(b.width(), b.height());
            } else {
                android.util.DisplayMetrics dm = new android.util.DisplayMetrics();
                wm.getDefaultDisplay().getRealMetrics(dm);
                p.set(dm.widthPixels, dm.heightPixels);
            }
        }
        screenW = p.x;
        screenH = p.y;

        if (capture != null) capture.stop();
        capture = new ScreenCapture(this);
        capture.start(mp, this);

        a11y.setScreen(screenW, screenH);
        shizuku.setScreen(screenW, screenH);

        if (prefs.anchorX() < 0 || prefs.anchorY() < 0) {
            anchorX = screenW / 2f;
            anchorY = screenH / 2f;
        } else {
            anchorX = prefs.anchorX();
            anchorY = prefs.anchorY();
        }

        overlays.showCanvas();
        overlays.setAnchor(anchorX, anchorY);
        overlays.setFov(prefs.fov());
        overlays.setAnchorVisible(false);
        overlays.showBubble(screenW - 190, screenH / 3);
        overlays.bubble().setCallback(new com.ovltools.core.overlay.BubbleOverlay.Callback() {
            @Override
            public void onAimDown() {
                aiming = true;
            }

            @Override
            public void onAimUp() {
                aiming = false;
            }

            @Override
            public void onMenu() {
                Intent i = new Intent(AimService.this, com.ovltools.core.SettingsActivity.class);
                i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
                startActivity(i);
            }

            @Override
            public void onDrag(float dx, float dy) {
                overlays.moveBubble(dx, dy);
            }

            @Override
            public void onStopAll() {
                stopAll();
            }
        });
        running = true;
    }

    private void startForegroundCompat() {
        Notification n = buildNotification();
        if (Build.VERSION.SDK_INT >= 29) {
            startForeground(NID, n, android.content.pm.ServiceInfo.FOREGROUND_SERVICE_TYPE_MEDIA_PROJECTION);
        } else {
            startForeground(NID, n);
        }
    }

    private Notification buildNotification() {
        Intent open = new Intent(this, MainActivity.class);
        PendingIntent pi = PendingIntent.getActivity(this, 0, open,
                PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE);
        Intent stop = new Intent(this, AimService.class);
        stop.setAction("stop");
        PendingIntent ps = PendingIntent.getService(this, 1, stop,
                PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE);
        return new NotificationCompat.Builder(this, CH)
                .setContentTitle("Servicio en ejecución")
                .setContentText("Asistente activo")
                .setSmallIcon(R.drawable.ic_launcher)
                .setOngoing(true)
                .setPriority(NotificationCompat.PRIORITY_LOW)
                .setContentIntent(pi)
                .addAction(0, "Detener", ps)
                .build();
    }

    private void createChannel() {
        if (Build.VERSION.SDK_INT < 26) return;
        NotificationManager nm = (NotificationManager) getSystemService(Context.NOTIFICATION_SERVICE);
        if (nm == null) return;
        NotificationChannel ch = new NotificationChannel(CH, "Servicio", NotificationManager.IMPORTANCE_LOW);
        ch.setShowBadge(false);
        nm.createNotificationChannel(ch);
    }

    @Override
    public void onFrame(FrameData f) {
        if (!running) {
            f.bitmap.recycle();
            return;
        }
        long now = System.currentTimeMillis();
        long interval = 1000L / Math.max(4, targetFps);
        if (now - lastFrameTs < interval) {
            f.bitmap.recycle();
            return;
        }
        lastFrameTs = now;
        frameCount++;

        if (busy.get()) {
            f.bitmap.recycle();
            return;
        }
        busy.set(true);
        final FrameData frame = f;
        worker.execute(new Runnable() {
            @Override
            public void run() {
                try {
                    long t0 = System.currentTimeMillis();
                    List<Detection> raw = detector.detect(frame.bitmap, prefs.threshold());
                    int cw = frame.bitmap.getWidth();
                    int ch = frame.bitmap.getHeight();
                    List<Detection> dets = PostProcess.filter(raw, cw, ch, prefs.excludeHud(), hudRects);
                    Detection target = tracker.pick(dets, cw, ch, System.currentTimeMillis());
                    long dt = System.currentTimeMillis() - t0;
                    lastInferMs = dt;
                    inferMsAvg = inferMsAvg == 0 ? dt : (inferMsAvg * 0.9f + dt * 0.1f);
                    inferCount++;
                    if (System.currentTimeMillis() - lastInferTs > 1000) {
                        fpsAvg = inferCount;
                        inferCount = 0;
                        lastInferTs = System.currentTimeMillis();
                    }
                    float sc = Coords.scaleFactor(cw, screenW);
                    overlays.render(dets, sc);
                    applyTarget(frame, target, sc);
                } catch (Throwable t) {
                    Log.w(TAG, "inferencia fallo", t);
                    modelState = "error: " + t.getClass().getSimpleName();
                } finally {
                    frame.bitmap.recycle();
                    busy.set(false);
                }
            }
        });
    }

    private void applyTarget(FrameData f, Detection t, float sc) {
        if (t == null) return;
        if (prefs.mode() == Prefs.MODE_HOLD && !aiming) return;

        float sx = Coords.toScreen(t.cx(), sc);
        float sy;
        int point = prefs.point();
        if (point == Prefs.POINT_HEAD) {
            sy = Coords.toScreen(t.y1 + t.h() * 0.12f, sc);
        } else if (point == Prefs.POINT_CHEST) {
            sy = Coords.toScreen(t.y1 + t.h() * 0.62f, sc);
        } else {
            sy = Coords.toScreen(t.y1 + t.h() * 0.28f, sc);
        }

        int jit = prefs.jitter();
        if (jit > 0) {
            sx += rnd.nextInt(jit * 2 + 1) - jit;
            sy += rnd.nextInt(jit * 2 + 1) - jit;
        }

        float dx = sx - anchorX;
        float dy = sy - anchorY;
        if (Math.abs(dx) < 6f && Math.abs(dy) < 6f) return;

        main.removeCallbacks(aimRunner);
        pendingDx = dx;
        pendingDy = dy;
        main.postDelayed(aimRunner, prefs.delay());
    }

    private void route(float dx, float dy) {
        float dist = (float) Math.sqrt(dx * dx + dy * dy);
        if (dist > 400f) {
            dx = dx / dist * 400f;
            dy = dy / dist * 400f;
        }
        if (shizuku.ready() && !prefs.preferA11y()) {
            shizuku.queue(dx, dy);
        } else if (AimAccessibilityService.isConnected()) {
            a11y.setStart(anchorX, anchorY);
            a11y.setPxPerMs(1f / Math.max(0.05f, prefs.msPerPx()));
            a11y.queue(dx, dy);
        }
    }

    @Override
    public void onError(Throwable t) {
        Log.e(TAG, "captura error, reinicio", t);
        main.postDelayed(new Runnable() {
            @Override
            public void run() {
                if (!running) return;
                if (capture != null) {
                    capture.stop();
                    capture = null;
                }
                overlays.destroy();
                running = false;
                stopSelf();
            }
        }, 1200);
    }

    public void setAnchorEdit(boolean on) {
        anchorEdit = on;
        overlays.setAnchorVisible(!on);
        if (on) {
            overlays.showAnchor(anchorX, anchorY);
            overlays.bubble().setCallback(null);
            final com.ovltools.core.overlay.AnchorOverlay a = null;
            overlays.setFov(prefs.fov());
        } else {
            overlays.hideAnchor();
            anchorX = overlays.anchorX() < 0 ? anchorX : overlays.anchorX();
            anchorY = overlays.anchorY() < 0 ? anchorY : overlays.anchorY();
            prefs.setAnchor(anchorX, anchorY);
        }
    }

    public void refreshSettings() {
        overlays.setFov(prefs.fov());
        targetFps = throttled ? 9 : prefs.fps();
        if (detector.isReady() && !"ok".equals(modelState.split("/")[0])) {
            modelState = "ok/" + detector.backend();
        }
    }

    public String diagnostics() {
        return "FPS cap " + frameCount + "\nFPS inf " + fpsAvg
                + "\nms inf " + String.format(java.util.Locale.US, "%.1f", inferMsAvg)
                + "\nmodelo " + modelState
                + "\nbackend " + (shizuku.ready() && !prefs.preferA11y() ? "shizuku" : "a11y")
                + "\ntermico " + (throttled ? "throttle" : "normal");
    }

    public void stopAll() {
        running = false;
        main.removeCallbacks(aimRunner);
        main.post(new Runnable() {
            @Override
            public void run() {
                overlays.destroy();
            }
        });
        if (capture != null) {
            capture.stop();
            capture = null;
        }
        worker.execute(new Runnable() {
            @Override
            public void run() {
                detector.close();
            }
        });
        thermal.stop(this);
        shizuku.shutdown();
        stopForeground(STOP_FOREGROUND_REMOVE);
        stopSelf();
    }

    @Override
    public void onDestroy() {
        I = null;
        running = false;
        if (capture != null) capture.stop();
        if (overlays != null) overlays.destroy();
        if (detector != null) detector.close();
        if (thermal != null) thermal.stop(this);
        if (shizuku != null) shizuku.shutdown();
        super.onDestroy();
    }

    @Override
    public IBinder onBind(Intent intent) {
        return null;
    }
