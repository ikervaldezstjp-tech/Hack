public class AnchorOverlay extends View {

    public interface Callback {
        void onDrag(float dx, float dy);
    }

    private final Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
    private Callback cb;
    private float downRawX, downRawY;

    public AnchorOverlay(Context c) {
        super(c);
        p.setStyle(Paint.Style.STROKE);
        p.setStrokeWidth(3f);
        p.setColor(0xFFFFC400);
        setLayerType(LAYER_TYPE_HARDWARE, null);
    }

    public void setCallback(Callback c) {
        cb = c;
    }

    @Override
    protected void onDraw(Canvas c) {
        float cx = getWidth() / 2f;
        float cy = getHeight() / 2f;
        c.drawLine(cx - 26, cy, cx - 6, cy, p);
        c.drawLine(cx + 6, cy, cx + 26, cy, p);
        c.drawLine(cx, cy - 26, cx, cy - 6, p);
        c.drawLine(cx, cy + 6, cx, cy + 26, p);
        c.drawCircle(cx, cy, 2.5f, p);
    }

    @SuppressLint("ClickableViewAccessibility")
    @Override
    public boolean onTouchEvent(MotionEvent e) {
        switch (e.getActionMasked()) {
            case MotionEvent.ACTION_DOWN:
                downRawX = e.getRawX();
                downRawY = e.getRawY();
                return true;
            case MotionEvent.ACTION_MOVE: {
                float dx = e.getRawX() - downRawX;
                float dy = e.getRawY() - downRawY;
                downRawX = e.getRawX();
                downRawY = e.getRawY();
                if (cb != null) cb.onDrag(dx, dy);
                return true;
            }
            default:
                return true;
        }
    }
