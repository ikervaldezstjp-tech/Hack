import java.util.ArrayList;
import java.util.Collections;
import java.util.Comparator;
import java.util.List;

public final class PostProcess {

    private PostProcess() {}

    public static final float MIN_ASPECT = 0.22f;
    public static final float MAX_ASPECT = 1.45f;
    public static final float MIN_H_RATIO = 0.045f;
    public static final float MAX_H_RATIO = 0.85f;
    public static final float NMS_IOU = 0.45f;
    public static final float MIN_SCORE = 0.30f;

    /** Filtra ruido en espacio captura. hudRects en normalizado [0..1]. */
    public static List<Detection> filter(List<Detection> in, int capW, int capH,
                                        boolean excludeHud, float[][] hudRects) {
        List<Detection> keep = new ArrayList<>();
        if (in == null || capW <= 0 || capH <= 0) return keep;
        for (Detection d : in) {
            if (d.classId != 0) continue;
            if (d.score < MIN_SCORE) continue;
            float h = d.h();
            float w = d.w();
            if (h < capH * MIN_H_RATIO || h > capH * MAX_H_RATIO) continue;
            float aspect = w / h;
            if (aspect < MIN_ASPECT || aspect > MAX_ASPECT) continue;
            float cx = d.cx();
            float cy = d.cy();
            boolean insideHud = false;
            if (excludeHud && hudRects != null) {
                for (float[] r : hudRects) {
                    float rx1 = r[0] * capW, ry1 = r[1] * capH;
                    float rx2 = r[2] * capW, ry2 = r[3] * capH;
                    if (cx >= rx1 && cx <= rx2 && cy >= ry1 && cy <= ry2) {
                        insideHud = true;
                        break;
                    }
                }
            }
            if (insideHud) continue;
            keep.add(d);
        }
        Collections.sort(keep, new Comparator<Detection>() {
            @Override
            public int compare(Detection a, Detection b) {
                return Float.compare(b.score, a.score);
            }
        });
        List<Detection> out = new ArrayList<>();
        for (Detection d : keep) {
            boolean drop = false;
            for (Detection k : out) {
                if (d.iou(k) > NMS_IOU) {
                    drop = true;
                    break;
                }
            }
            if (!drop) out.add(d);
            if (out.size() >= 8) break;
        }
        return out;
    }
