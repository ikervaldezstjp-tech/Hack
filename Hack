import java.lang.reflect.Method;

/**
 * Ruta Shizuku: proceso `sh` persistente, eventos con `input motionevent`.
 * Solo si Shizuku responde, hay permiso concedido y API >= 30.
 */
public class ShizukuInjector extends Injector {

    private static final String TAG = "ShizukuInjector";
    private static final String[] API_CLASSES = {
            "moe.shizuku.api.ShizukuApi", "moe.shizuku.api.ShizukuService"
    };

    private Process proc;
    private OutputStream out;
    private volatile boolean ready;
    private int screenW = 1080, screenH = 1920;

    public ShizukuInjector(Handler h) {
        super(h);
    }

    public boolean ready() { return ready; }

    public void setScreen(int w, int h) {
        screenW = w;
        screenH = h;
    }

    private static Object callStatic(String method, Class<?>[] types, Object... args) {
        for (String cn : API_CLASSES) {
            try {
                Class<?> c = Class.forName(cn);
                Method m = c.getMethod(method, types);
                return m.invoke(null, args);
            } catch (Throwable ignored) {
            }
        }
        return null;
    }

    public void init() {
        ready = false;
        if (Build.VERSION.SDK_INT < 30) return;
        try {
            Object pong = callStatic("pingBinder", new Class<?>[0]);
            if (!(pong instanceof Boolean) || !((Boolean) pong)) return;
            Object perm = callStatic("checkSelfPermission", new Class<?>[0]);
            if (!(perm instanceof Integer) || ((Integer) perm) != 0) {
                callStatic("requestPermission", new Class<?>[]{int.class}, 4242);
            }
            Object p = callStatic("newProcess",
                    new Class<?>[]{String[].class, String[].class, String.class},
                    new String[]{"sh"}, null, null);
            if (p == null) return;
            Method gos = p.getClass().getMethod("getOutputStream");
            Object o = gos.invoke(p);
            if (!(o instanceof OutputStream)) return;
            out = (OutputStream) o;
            if (p instanceof Process) proc = (Process) p;
            ready = true;
        } catch (Throwable t) {
            Log.w(TAG, "Shizuku no disponible: " + t.getMessage());
            ready = false;
        }
    }

    private void write(String s) {
        if (!ready || out == null) return;
        try {
            out.write((s + "\n").getBytes());
            out.flush();
        } catch (Throwable t) {
            ready = false;
        }
    }

    @Override
    protected void startStroke(float dx, float dy) {
        doStroke(dx, dy);
    }

    @Override
    protected void continueStroke(float dx, float dy) {
        doStroke(dx, dy);
    }

    private void doStroke(float dx, float dy) {
        final float ex = Coords.clamp(dx, -screenW, screenW);
        final float ey = Coords.clamp(dy, -screenH, screenH);
        float dist = (float) Math.sqrt(ex * ex + ey * ey);
        final int dur = (int) Coords.clamp(dist / 1.1f, 40, 220);

        final float x0 = screenW / 2f;
        final float y0 = screenH / 2f;
        final float x1 = Coords.clamp(x0 + ex, 0, screenW - 1);
        final float y1 = Coords.clamp(y0 + ey, 0, screenH - 1);
        final float mx = (x0 + x1) / 2f;
        final float my = (y0 + y1) / 2f;

        handler.post(new Runnable() {
            @Override
            public void run() {
                write("input motionevent DOWN " + (int) x0 + " " + (int) y0);
                write("sleep 0.02");
                write("input motionevent MOVE " + (int) mx + " " + (int) my);
                write("input motionevent MOVE " + (int) x1 + " " + (int) y1);
                write("input motionevent UP " + (int) x1 + " " + (int) y1);
                handler.postDelayed(new Runnable() {
                    @Override
                    public void run() {
                        completed();
                    }
                }, dur + 60L);
            }
        });
    }

    public void shutdown() {
        ready = false;
        try {
            if (out != null) out.close();
        } catch (Throwable ignored) { }
        try {
            if (proc != null) proc.destroy();
        } catch (Throwable ignored) { }
        out = null;
        proc = null;
    }
