tasks.register('fetchModel') {
    onlyIf { !modelFile.exists() || modelFile.length() < 3_000_000L }
    doLast {
        modelDir.mkdirs()
        def urls = [
                'https://github.com/ultralytics/assets/releases/download/v8.3.0/yolov8n_int8.tflite',
                'https://github.com/ultralytics/assets/releases/download/v8.2.0/yolov8n_int8.tflite',
                'https://github.com/ultralytics/assets/releases/download/v8.1.0/yolov8n_int8.tflite',
                'https://github.com/ultralytics/assets/releases/download/v8.0.0/yolov8n_int8.tflite'
        ]
        for (u in urls) {
            try {
                logger.lifecycle("Descargando modelo: $u")
                new URL(u).withInputStream { input -> modelFile.withOutputStream { out -> out << input } }
                if (modelFile.length() > 3_000_000L) {
                    logger.lifecycle("Modelo OK (${modelFile.length()} bytes)")
                    return
                }
            } catch (Throwable t) {
                logger.lifecycle("Fallo: ${t.message}")
                modelFile.delete()
            }
        }
        logger.lifecycle("AVISO: no se pudo descargar el modelo. La app mostrará aviso en pantalla.")
    }
}

