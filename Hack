public class Detection {

    public float x1, y1, x2, y2;
    public float score;
    public int classId;
    public float persistence;

    public Detection() {}

    public Detection(float x1, float y1, float x2, float y2, float score, int classId) {
        this.x1 = x1;
        this.y1 = y1;
        this.x2 = x2;
        this.y2 = y2;
        this.score = score;
        this.classId = classId;
    }

    public float cx() { return (x1 + x2) * 0.5f; }
    public float cy() { return (y1 + y2) * 0.5f; }
    public float w() { return x2 - x1; }
    public float h() { return y2 - y1; }

    public float iou(Detection o) {
        float ix1 = Math.max(x1, o.x1);
        float iy1 = Math.max(y1, o.y1);
        float ix2 = Math.min(x2, o.x2);
        float iy2 = Math.min(y2, o.y2);
        float iw = ix2 - ix1;
        float ih = iy2 - iy1;
        if (iw <= 0 || ih <= 0) return 0f;
        float inter = iw * ih;
        float uni = w() * h() + o.w() * o.h() - inter;
        return uni <= 0 ? 0f : inter / uni;
    }
