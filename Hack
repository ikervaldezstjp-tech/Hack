import android.os.PowerManager;

public class Thermal {

    public interface Listener {
        void onLevel(int status);
    }

    private PowerManager.OnThermalStatusChangeListener cb;

    public void start(Context c, final Listener l) {
        if (Build.VERSION.SDK_INT < 29) return;
        PowerManager pm = (PowerManager) c.getSystemService(Context.POWER_SERVICE);
        if (pm == null) return;
        cb = new PowerManager.OnThermalStatusChangeListener() {
            @Override
            public void onThermalStatusChanged(int status) {
                l.onLevel(status);
            }
        };
        pm.addThermalStatusListener(cb);
        l.onLevel(pm.getCurrentThermalStatus());
    }

    public void stop(Context c) {
        if (Build.VERSION.SDK_INT < 29 || cb == null) return;
        PowerManager pm = (PowerManager) c.getSystemService(Context.POWER_SERVICE);
        if (pm != null) pm.removeThermalStatusListener(cb);
        cb = null;
    }
