/**
 * Tres espacios de coordenadas:
 *  - captura: bitmap downscaleado (lado max 640)
 *  - pantalla: px absolutos del display
 *  - overlay: identico a pantalla
 * s = anchoCaptura / anchoPantalla. deteccion -> pantalla dividiendo por s.
 * El gesto SIEMPRE se emite en coordenadas de pantalla.
 */
public final class Coords {

    private Coords() {}

    public static float scaleFactor(int captureWidth, int screenWidth) {
        if (screenWidth <= 0) return 1f;
        return (float) captureWidth / (float) screenWidth;
    }

    public static float toScreen(float captureValue, float s) {
        return s <= 0f ? captureValue : captureValue / s;
    }

    public static float toCapture(float screenValue, float s) {
        return screenValue * s;
    }

    public static float clamp(float v, float lo, float hi) {
        return v < lo ? lo : (v > hi ? hi : v);
    }

    public static int clampI(int v, int lo, int hi) {
        return v < lo ? lo : (v > hi ? hi : v);
    }
