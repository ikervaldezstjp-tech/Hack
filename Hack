import android.os.Handler;

/**
 * Mutex de inyeccion: nunca se dispara un gesto nuevo con otro en vuelo.
 * El delta se acumula y se emite al completar el gesto actual (encadenado).
 */
public abstract class Injector {

    protected final Handler handler;
    private final Object lock = new Object();
    private boolean inFlight;
    private float pendDx, pendDy;

    protected Injector(Handler h) {
        this.handler = h;
    }

    public final void queue(float dx, float dy) {
        synchronized (lock) {
            if (!inFlight) {
                inFlight = true;
                startStroke(dx, dy);
            } else {
                pendDx += dx;
                pendDy += dy;
            }
        }
    }

    protected final void completed() {
        float dx;
        float dy;
        synchronized (lock) {
            if (Math.abs(pendDx) >= 1f || Math.abs(pendDy) >= 1f) {
                dx = pendDx;
                dy = pendDy;
                pendDx = 0f;
                pendDy = 0f;
            } else {
                pendDx = 0f;
                pendDy = 0f;
                inFlight = false;
                return;
            }
        }
        continueStroke(dx, dy);
    }

    protected final void reset() {
        synchronized (lock) {
            pendDx = 0f;
            pendDy = 0f;
            inFlight = false;
        }
    }

    public final boolean busy() {
        synchronized (lock) {
            return inFlight;
        }
    }

    protected abstract void startStroke(float dx, float dy);

    protected abstract void continueStroke(float dx, float dy);
