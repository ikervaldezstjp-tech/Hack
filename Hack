"""
Reentrena YOLOv8n con recortes de CODM y exporta INT8 TFLite.

    pip install ultralytics
    python tools/export_model.py --data codm.yaml --epochs 60

`codm.yaml` es un dataset YOLO normal (carpeta images/ + labels/, clase 0 = enemigo).
El resultado se copia a app/src/main/assets/models/yolov8n_int8.tflite
y se sube al repo; la app lo usa desde el primer arranque.

El reentrenamiento es opcional: la app funciona con el COCO por defecto.
"""
import argparse
import shutil
from pathlib import Path

DEST = Path(__file__).resolve().parent.parent / "app/src/main/assets/models/yolov8n_int8.tflite"


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--data", default="codm.yaml")
    ap.add_argument("--epochs", type=int, default=60)
    ap.add_argument("--imgsz", type=int, default=640)
    ap.add_argument("--weights", default="yolov8n.pt")
    ap.add_argument("--skip-train", action="store_true")
    args = ap.parse_args()

    from ultralytics import YOLO

    weights = args.weights
    if not args.skip_train:
        YOLO(weights).train(data=args.data, epochs=args.epochs, imgsz=args.imgsz,
                            batch=16, patience=15, project="runs", name="codm")
        weights = "runs/codm/weights/best.pt"

    out = YOLO(weights).export(format="tflite", int8=True, imgsz=args.imgsz)
    shutil.copy(str(out), DEST)
    print(f"Modelo copiado a {DEST} ({DEST.stat().st_size} bytes)")


if __name__ == "__main__":
    main()
