public class Detector {

    private static final String TAG = "Detector";
    public static final int IN = 640;
    public static final String ASSET = "models/yolov8n_int8.tflite";

    private Interpreter itp;
    private GpuDelegate gpu;
    private boolean ready;
    private String backend = "none";
    private String error = "";

    private int layout;
    private int numAnchors;
    private int numClasses;
    private float inScale = 1f;
    private int inZero = 0;
    private DataType inType = DataType.FLOAT32;
    private float outScale = 1f;
    private int outZero = 0;
    private DataType outType = DataType.FLOAT32;

    private ByteBuffer inputBuf;
    private ByteBuffer outputBuf;

    public boolean isReady() { return ready; }
    public String backend() { return backend; }
    public String error() { return error; }

    public boolean load(Context ctx) {
        MappedByteBuffer model = mapModel(ctx);
        if (model == null) {
            error = "Modelo ausente en assets (" + ASSET + ")";
            ready = false;
            return false;
        }
        try {
            Interpreter.Options o = new Interpreter.Options();
            o.setNumThreads(4);
            boolean gpuOk = false;
            try {
                CompatibilityList cl = new CompatibilityList();
                if (cl.isDelegateSupportedOnThisDevice()) {
                    gpu = new GpuDelegate(new GpuDelegate.Options());
                    o.addDelegate(gpu);
                    gpuOk = true;
                }
            } catch (Throwable t) {
                Log.w(TAG, "GPU delegate no disponible", t);
                gpu = null;
            }
            try {
                itp = new Interpreter(model, o);
                backend = gpuOk ? "GPU" : "CPU";
            } catch (Throwable t) {
                Log.w(TAG, "Interpreter con delegado fallo, reintento XNNPACK", t);
                if (gpu != null) {
                    try { gpu.close(); } catch (Throwable ignored) { }
                    gpu = null;
                }
                Interpreter.Options o2 = new Interpreter.Options();
                o2.setNumThreads(4);
                o2.setUseXNNPACK(true);
                itp = new Interpreter(model, o2);
                backend = "XNNPACK";
            }
        } catch (Throwable t) {
            error = "No se pudo inicializar TFLite: " + t.getMessage();
            ready = false;
            return false;
        }

        try {
            Tensor in = itp.getInputTensor(0);
            Tensor out = itp.getOutputTensor(0);
            inType = in.dataType();
            outType = out.dataType();
            if (inType == DataType.INT8 || inType == DataType.UINT8) {
                inScale = in.quantizationParams().getScale();
                inZero = in.quantizationParams().getZeroPoint();
            }
            if (outType == DataType.INT8 || outType == DataType.UINT8) {
                outScale = out.quantizationParams().getScale();
                outZero = out.quantizationParams().getZeroPoint();
            }
            int[] oshape = out.shape();
            if (oshape.length == 3 && oshape[1] < oshape[2]) {
                layout = 0;
                numClasses = oshape[1] - 4;
                numAnchors = oshape[2];
            } else if (oshape.length == 3) {
                layout = 1;
                numAnchors = oshape[1];
                numClasses = oshape[2] - 4;
            } else {
                error = "Forma de salida no soportada";
                ready = false;
                return false;
            }
            inputBuf = ByteBuffer.allocateDirect(in.numBytes()).order(ByteOrder.nativeOrder());
            outputBuf = ByteBuffer.allocateDirect(out.numBytes()).order(ByteOrder.nativeOrder());
            ready = true;
            error = "";
            return true;
        } catch (Throwable t) {
            error = "Tensores invalidos: " + t.getMessage();
            ready = false;
            return false;
        }
    }

    private MappedByteBuffer mapModel(Context ctx) {
        try (AssetFileDescriptor afd = ctx.getAssets().openFd(ASSET);
             FileInputStream fis = new FileInputStream(afd.getFileDescriptor())) {
            FileChannel ch = fis.getChannel();
            return ch.map(FileChannel.MapMode.READ_ONLY, afd.getStartOffset(), afd.getDeclaredLength());
        } catch (Throwable t) {
            Log.w(TAG, "asset no disponible: " + t.getMessage());
            return null;
        }
    }

    private void putPixel(ByteBuffer b, int v) {
        int c = v < 0 ? 0 : (v > 255 ? 255 : v);
        if (inType == DataType.FLOAT32) {
            b.putFloat(c / 255f);
        } else if (inType == DataType.UINT8) {
            int q = Math.round(c / 255f / inScale) + inZero;
            b.put((byte) Math.max(0, Math.min(255, q)));
        } else {
            int q = Math.round(c / 255f / inScale) + inZero;
            b.put((byte) Math.max(-128, Math.min(127, q)));
        }
    }

    public List<Detection> detect(Bitmap src, float threshold) {
        if (!ready || itp == null || src == null) return new ArrayList<>();
        int sw = src.getWidth();
        int sh = src.getHeight();
        if (sw <= 0 || sh <= 0) return new ArrayList<>();

        float r = Math.min((float) IN / sw, (float) IN / sh);
        int nw = Math.max(1, Math.round(sw * r));
        int nh = Math.max(1, Math.round(sh * r));
        int ox = (IN - nw) / 2;
        int oy = (IN - nh) / 2;

        inputBuf.rewind();
        for (int i = 0; i < IN * IN; i++) putPixel(inputBuf, 114);

        Bitmap scaled = Bitmap.createScaledBitmap(src, nw, nh, true);
        int[] px = new int[nw * nh];
        scaled.getPixels(px, 0, nw, 0, 0, nw, nh);
        if (scaled != src) scaled.recycle();

        for (int y = 0; y < nh; y++) {
            int base = (oy + y) * IN + ox;
            for (int x = 0; x < nw; x++) {
                int p = px[y * nw + x];
                int v = (int) (0.299f * ((p >> 16) & 0xFF) + 0.587f * ((p >> 8) & 0xFF) + 0.114f * (p & 0xFF));
                int idx = (base + x) * 3;
                inputBuf.position(idx);
                putPixel(inputBuf, v);
                putPixel(inputBuf, v);
                putPixel(inputBuf, v);
            }
        }
        inputBuf.rewind();
        outputBuf.rewind();

        itp.run(inputBuf, outputBuf);

        List<Detection> out = new ArrayList<>();
        int stride = 4 + numClasses;
        for (int i = 0; i < numAnchors; i++) {
            float cx = read(i, 0, stride);
            float cy = read(i, 1, stride);
            float bw = read(i, 2, stride);
            float bh = read(i, 3, stride);
            float best = 0f;
            int bestId = -1;
            for (int c = 0; c < numClasses; c++) {
                float s = read(i, 4 + c, stride);
                if (s > best) {
                    best = s;
                    bestId = c;
                }
            }
            if (bestId < 0 || best < threshold) continue;
            float x1 = (cx - bw / 2f - ox) / r;
            float y1 = (cy - bh / 2f - oy) / r;
            float x2 = (cx + bw / 2f - ox) / r;
            float y2 = (cy + bh / 2f - oy) / r;
            x1 = Math.max(0, Math.min(sw, x1));
            x2 = Math.max(0, Math.min(sw, x2));
            y1 = Math.max(0, Math.min(sh, y1));
            y2 = Math.max(0, Math.min(sh, y2));
            if (x2 <= x1 || y2 <= y1) continue;
            out.add(new Detection(x1, y1, x2, y2, best, bestId));
        }
        return out;
    }

    private float read(int anchor, int channel, int stride) {
        int idx = layout == 0 ? channel * numAnchors + anchor : anchor * stride + channel;
        if (outType == DataType.FLOAT32) {
            return outputBuf.getFloat(idx * 4);
        }
        byte raw = outputBuf.get(idx);
        int v = outType == DataType.UINT8 ? (raw & 0xFF) : raw;
        return (v - outZero) * outScale;
    }

    public void close() {
        ready = false;
        try {
            if (itp != null) itp.close();
        } catch (Throwable ignored) { }
        try {
            if (gpu != null) gpu.close();
        } catch (Throwable ignored) { }
        itp = null;
        gpu = null;
    }
