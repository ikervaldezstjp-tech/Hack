public final class Profiles {

    public static final class Profile {
        public String name;
        public int fov;
        public float msPerPx;
        public int delay;
        public int jitter;
        public int point;
        public float threshold;
        public int mode;
    }

    private Profiles() {}

    private static File file(Context c) {
        return new File(c.getFilesDir(), "profiles.json");
    }

    public static List<Profile> load(Context c) {
        List<Profile> out = new ArrayList<>();
        File f = file(c);
        if (!f.exists()) return out;
        try (InputStream in = new FileInputStream(f)) {
            ByteArrayOutputStream bos = new ByteArrayOutputStream();
            byte[] buf = new byte[4096];
            int n;
            while ((n = in.read(buf)) > 0) bos.write(buf, 0, n);
            JSONArray arr = new JSONArray(new String(bos.toByteArray(), StandardCharsets.UTF_8));
            for (int i = 0; i < arr.length(); i++) {
                JSONObject o = arr.getJSONObject(i);
                Profile p = new Profile();
                p.name = o.optString("name", "perfil");
                p.fov = o.optInt("fov", 200);
                p.msPerPx = (float) o.optDouble("msPerPx", 0.9);
                p.delay = o.optInt("delay", 120);
                p.jitter = o.optInt("jitter", 2);
                p.point = o.optInt("point", 1);
                p.threshold = (float) o.optDouble("threshold", 0.35);
                p.mode = o.optInt("mode", 0);
                out.add(p);
            }
        } catch (Throwable ignored) {
        }
        return out;
    }

    public static boolean save(Context c, List<Profile> list) {
        try {
            JSONArray arr = new JSONArray();
            for (Profile p : list) {
                JSONObject o = new JSONObject();
                o.put("name", p.name);
                o.put("fov", p.fov);
                o.put("msPerPx", (double) p.msPerPx);
                o.put("delay", p.delay);
                o.put("jitter", p.jitter);
                o.put("point", p.point);
                o.put("threshold", (double) p.threshold);
                o.put("mode", p.mode);
                arr.put(o);
            }
            try (FileOutputStream out = new FileOutputStream(file(c))) {
                out.write(arr.toString(2).getBytes(StandardCharsets.UTF_8));
            }
            return true;
        } catch (Throwable t) {
            return false;
        }
    }

    public static void apply(Prefs prefs, Profile p) {
        prefs.setFov(p.fov);
        prefs.setMsPerPx(p.msPerPx);
        prefs.setDelay(p.delay);
        prefs.setJitter(p.jitter);
        prefs.setPoint(p.point);
        prefs.setThreshold(p.threshold);
        prefs.setMode(p.mode);
    }

    public static String exportJson(Context c) {
        File f = file(c);
        if (!f.exists()) return "[]";
        try (InputStream in = new FileInputStream(f)) {
            ByteArrayOutputStream bos = new ByteArrayOutputStream();
            byte[] buf = new byte[4096];
            int n;
            while ((n = in.read(buf)) > 0) bos.write(buf, 0, n);
            return new String(bos.toByteArray(), StandardCharsets.UTF_8);
        } catch (Throwable t) {
            return "[]";
        }
    }

    public static boolean importJson(Context c, String json) {
        try {
            JSONArray arr = new JSONArray(json);
            List<Profile> out = new ArrayList<>();
            for (int i = 0; i < arr.length(); i++) {
                JSONObject o = arr.getJSONObject(i);
                Profile p = new Profile();
                p.name = o.optString("name", "importado");
                p.fov = o.optInt("fov", 200);
                p.msPerPx = (float) o.optDouble("msPerPx", 0.9);
                p.delay = o.optInt("delay", 120);
                p.jitter = o.optInt("jitter", 2);
                p.point = o.optInt("point", 1);
                p.threshold = (float) o.optDouble("threshold", 0.35);
                p.mode = o.optInt("mode", 0);
                out.add(p);
            }
            return save(c, out);
        } catch (Throwable t) {
            return false;
        }
    }
